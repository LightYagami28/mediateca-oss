# Variabili d'ambiente lette dal programma. Nomi e significato, nessun valore.
# Copia in un file del tuo ambiente (non committare i valori).

# Radice dei dati (database, impostazioni, backup, cache, log). Predefinito: %APPDATA%\Mediateca
MEDIATECA_HOME=

# Server: indirizzo e porta di ascolto (alternative a --bind e --port)
MEDIATECA_BIND=
MEDIATECA_PORT=

# Token Bearer per le API JSON (obbligatorio se si ascolta fuori da 127.0.0.1)
MEDIATECA_API_TOKEN=

# Bot Telegram
MEDIATECA_TELEGRAM_BOT_TOKEN=

# Chiave API di TMDB per lo scraper dei metadati
MEDIATECA_TMDB_API_KEY=

# Backup su Google Drive (client OAuth desktop, ambito drive.file)
MEDIATECA_GDRIVE_CLIENT_ID=
MEDIATECA_GDRIVE_CLIENT_SECRET=
MEDIATECA_GDRIVE_REFRESH_TOKEN=
MEDIATECA_GDRIVE_FOLDER_ID=

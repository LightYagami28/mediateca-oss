<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Mediateca.Ui.Converters"
             x:Class="Mediateca.Ui.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Mediateca.Ui/Styles/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:HexToBrushConverter x:Key="HexBrush" />
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Mediateca.Ui/Styles/Theme.axaml" />
  </Application.Styles>

</Application>

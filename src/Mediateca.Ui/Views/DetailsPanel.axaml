<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mediateca.Ui.Views.DetailsPanel"
             Width="330">

  <Border Classes="panel" Padding="18,16">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <StackPanel Grid.Row="0" Spacing="4">
        <TextBlock Text="Dettaglio" Classes="section" />
        <TextBlock Text="{Binding DetailTitle}" Classes="h3" TextWrapping="Wrap" MaxLines="2" />
        <TextBlock Text="{Binding DetailSubtitle}" Classes="caption" />
      </StackPanel>

      <Border Grid.Row="1" Height="150" Margin="0,14" Classes="stat">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
          <Border Width="40" Height="40" CornerRadius="20"
                  Background="{Binding DetailKind, Converter={StaticResource HexBrush}}">
            <TextBlock Text="▶" Foreground="#101418" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding DetailKind}" Classes="caption" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="2" Spacing="8">
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" >
          <Border Grid.Row="0" Grid.Column="0" Classes="stat" Margin="0,0,4,4">
            <StackPanel>
              <TextBlock Text="Dimensione" Classes="statlabel" />
              <TextBlock Text="{Binding DetailSize}" Classes="statvalue" />
            </StackPanel>
          </Border>
          <Border Grid.Row="0" Grid.Column="1" Classes="stat" Margin="4,0,0,4">
            <StackPanel>
              <TextBlock Text="Durata" Classes="statlabel" />
              <TextBlock Text="{Binding DetailDuration}" Classes="statvalue" />
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="0" Classes="stat" Margin="0,0,4,4">
            <StackPanel>
              <TextBlock Text="Tipo" Classes="statlabel" />
              <TextBlock Text="{Binding DetailKind}" Classes="statvalue" />
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="1" Classes="stat" Margin="4,0,0,4">
            <StackPanel>
              <TextBlock Text="Anno" Classes="statlabel" />
              <TextBlock Text="{Binding DetailYear}" Classes="statvalue" />
            </StackPanel>
          </Border>
          <Border Grid.Row="2" Grid.Column="0" Classes="stat" Margin="0,4,4,0">
            <StackPanel>
              <TextBlock Text="Canale" Classes="statlabel" />
              <TextBlock Text="{Binding DetailChannel}" Classes="statvalue" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
          <Border Grid.Row="2" Grid.Column="1" Classes="stat" Margin="4,4,0,0">
            <StackPanel>
              <TextBlock Text="Scopo" Classes="statlabel" />
              <TextBlock Text="Streaming" Classes="statvalue" />
            </StackPanel>
          </Border>
        </Grid>

        <TextBlock Text="Azioni" Classes="section" Margin="0,8,0,0" />
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" >
          <Button Grid.Row="0" Grid.Column="0" Classes="accent" Content="Riproduci" Margin="0,0,4,4" />
          <Button Grid.Row="0" Grid.Column="1" Classes="command" Content="Scarica" Margin="4,0,0,4" />
          <Button Grid.Row="1" Grid.Column="0" Classes="command" Content="Apri canale" Margin="0,4,4,0" />
          <Button Grid.Row="1" Grid.Column="1" Classes="command" Content="Copia link" Margin="4,4,0,0" />
        </Grid>
      </StackPanel>

      <TextBlock Grid.Row="3" Text="Nessuna funzione e' bloccata: licenza assente, software completo."
                 Classes="caption" TextWrapping="Wrap" Margin="0,12,0,0" />
    </Grid>
  </Border>
</UserControl>
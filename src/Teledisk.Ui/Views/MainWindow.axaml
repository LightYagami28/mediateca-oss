<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Teledisk.Ui.Views"
        xmlns:vm="using:Teledisk.Ui.ViewModels"
        x:Class="Teledisk.Ui.Views.MainWindow"
        Title="Teledisk Community"
        Width="1440"
        Height="900"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="52,*,30">

    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="16,0">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource AccentBrush}">
            <TextBlock Text="T" Foreground="White" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
          </Border>
          <TextBlock Text="Teledisk" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
          <TextBlock Text="Community" Classes="caption" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="20,0" VerticalAlignment="Center">
          <Border Classes="pill">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" />
              <TextBlock Text="Server attivo" Classes="caption" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </Border>
          <Border Classes="pill">
            <TextBlock Text="Bot: non connesso" Classes="caption" Foreground="{DynamicResource TextMutedBrush}" />
          </Border>
        </StackPanel>

        <TextBox Grid.Column="2"
                 x:Name="SearchBox"
                 Classes="search"
                 Width="440"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 PlaceholderText="Cerca nel catalogo   (Ctrl+K)"
                 Text="{Binding Search}" />

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="command" Command="{Binding RefreshCommand}" Content="Aggiorna" />
          <Button Classes="command" Command="{Binding ToggleThemeCommand}" Content="Tema" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="248,*,Auto">

      <Border Grid.Column="0" Classes="panel">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12,14" Spacing="16">
            <ItemsControl ItemsSource="{Binding Sections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:NavSection">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Title}" Classes="section" Margin="12,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:NavItem">
                          <ToggleButton Classes="nav"
                                        IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        Command="{Binding SelectCommand}"
                                        CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="{Binding Badge}" Classes="caption" VerticalAlignment="Center" />
                            </Grid>
                          </ToggleButton>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <ContentControl Grid.Column="1" Content="{Binding CurrentView}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:CatalogViewModel"><views:CatalogView /></DataTemplate>
          <DataTemplate DataType="vm:ChannelsViewModel"><views:ChannelsView /></DataTemplate>
          <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
          <DataTemplate DataType="vm:LogsViewModel"><views:LogsView /></DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>

      <views:DetailsPanel Grid.Column="2" Width="330" />
    </Grid>

    <Border Grid.Row="2"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="16,0">
        <TextBlock Text="{Binding ServerStatusText}" Classes="caption" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding FreeSpaceText}" Classes="caption" VerticalAlignment="Center" Margin="20,0" />
        <TextBlock Grid.Column="2" Text="Nessuna funzione è bloccata: software completo senza licenza." Classes="caption" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding VersionText}" Classes="caption" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
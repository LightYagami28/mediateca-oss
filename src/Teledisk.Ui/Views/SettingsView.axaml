<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Teledisk.Ui.Views.SettingsView">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="18,14" Spacing="14" MaxWidth="760" HorizontalAlignment="Left">

      <StackPanel Spacing="4">
        <TextBlock Text="Impostazioni" Classes="h2" />
        <TextBlock Text="Le modifiche al server richiedono il riavvio dell'applicazione." Classes="caption" />
      </StackPanel>

      <Border Classes="card" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="Aspetto" Classes="section" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Tema chiaro" />
              <TextBlock Text="Alterna il tema scuro e quello chiaro." Classes="caption" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsLightTheme}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="Server HTTP" Classes="section" />
          <StackPanel Spacing="6">
            <TextBlock Text="Indirizzo di ascolto" Classes="caption" />
            <TextBox Text="{Binding ServerBindAddress}" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="Porta" Classes="caption" />
            <TextBox Text="{Binding ServerPort}" Width="160" HorizontalAlignment="Left" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="Token API (vuoto = senza autenticazione)" Classes="caption" />
            <TextBox Text="{Binding ServerApiToken}" PasswordChar="•" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="Password WebDAV (vuoto = non modificare)" Classes="caption" />
            <TextBox Text="{Binding WebDavPassword}" PasswordChar="•" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Area WebDAV in sola lettura" />
              <TextBlock Text="Espone il catalogo a rclone, Jellyfin ed Emby." Classes="caption" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding WebDavEnabled}" />
          </Grid>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Classes="accent" Content="Salva" Command="{Binding SaveCommand}" />
        <TextBlock Text="{Binding StatusText}" Classes="caption" VerticalAlignment="Center" />
      </StackPanel>

      <Border Classes="card" Padding="14">
        <TextBlock Text="Il token API è protetto con la crittografia dell'utente Windows prima di essere salvato su disco."
                   Classes="caption" TextWrapping="Wrap" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
